# Nginx container for Accident Severity Predictor
# Uses nginx:alpine for minimal image size

FROM nginx:alpine

# Labels for metadata
LABEL maintainer="Rackkoun"
LABEL description="Nginx reverse proxy for ASP project"

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy certificates directory
COPY certs /etc/nginx/certs

# Expose ports
EXPOSE 80 443

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
